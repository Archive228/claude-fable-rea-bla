{
  "model": "fable",
  "modelSettings": {
    "fable": { "effortLevel": "high" }
  },
  "maxEffortLevel": "xhigh",
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Bash(npx rea-agents:*)",
      "Bash(npx bla-agents:*)",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/format.sh)",
      "Bash(./run.sh)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Edit(tests/**)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": ".claude/hooks/pre-tool-use.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": ".claude/hooks/post-tool-use.sh" } ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": ".claude/hooks/verify.sh" } ] }
    ]
  }
}
